{
  "name": "faultline-react",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs && node scripts/prepare-assets.mjs",
    "dev": "npm run content && react-router dev",
    "typecheck": "npm run content && react-router typegen && tsc --noEmit",
    "build": "npm run content && node scripts/clean-build.mjs && react-router build && node scripts/export-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:static": "node scripts/check-static.mjs"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-to-jsx-runtime": "2.3.6",
    "image-size": "2.0.2",
    "isbot": "5.2.2",
    "katex": "0.16.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sass": "1.105.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
